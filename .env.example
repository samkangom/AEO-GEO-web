# Copy to .env.local and fill in.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL, for canonical links, robots.txt and sitemap (optional on Vercel)
NEXT_PUBLIC_SITE_URL=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=              # optional, default gpt-5.5
ANTHROPIC_MODEL=           # optional, default claude-opus-5-5
# Simulated AI answers for demos/QA without keys (labelled "Mock" everywhere).
# Ignored on the production site; works locally and on Vercel preview deployments.
MOCK_AI_RESPONSES=
GEMINI_API_KEY=            # optional, adapter stubs if absent
PERPLEXITY_API_KEY=        # optional, adapter stubs if absent
