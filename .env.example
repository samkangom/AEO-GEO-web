# Copy to .env.local and fill in.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never NEXT_PUBLIC_. Used by scheduled monitoring and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Scheduled weekly monitoring: a long random string. Vercel Cron sends it automatically.
CRON_SECRET=

# Public URL, for canonical links, robots.txt and sitemap (optional on Vercel)
NEXT_PUBLIC_SITE_URL=

# AI providers: each engine is used when its key is set, and shows "Not configured" otherwise.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=         # also writes prompts and tags sentiment
GEMINI_API_KEY=            # Google AI Studio; has a free tier
PERPLEXITY_API_KEY=
OPENAI_MODEL=              # optional, default gpt-5.5
ANTHROPIC_MODEL=           # optional, default claude-opus-5-5
GEMINI_MODEL=              # optional, default gemini-flash-latest
PERPLEXITY_MODEL=          # optional, default sonar
# Simulated AI answers for demos/QA without keys (labelled "Mock" everywhere).
# Ignored on the production site; works locally and on Vercel preview deployments.
MOCK_AI_RESPONSES=
# Only for a test/demo deployment that Vercel treats as production. Remove before launch.
ALLOW_MOCK_ON_PRODUCTION=
